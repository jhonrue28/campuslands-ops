# Copia este archivo a .env en la raíz del proyecto.
# No coloques credenciales reales en el repositorio.

# Ruta relativa al directorio backend/. Se resuelve a backend/data/campuslands.db
DATABASE_URL=sqlite:///./data/campuslands.db

# Proveedor compatible con la API de chat de OpenAI (OpenAI, Groq, OpenRouter, etc.).
# Si AI_API_KEY está vacía, el análisis usa el modo de respaldo por reglas
# y la interfaz lo identifica como tal. No simula una respuesta del modelo.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30

# Requisito de la competencia. El backend mantiene sync_v26_node en true.
SYNC_V26_NODE=true
